generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  phone         String?
  password      String
  role          String         @default("CUSTOMER")
  avatar        String?        @db.Text
  address       String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  reviews       Review[]
  orders        Order[]
  notifications Notification[]
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id              Int              @id @default(autoincrement())
  name            String
  slug            String           @unique
  description     String           @db.Text
  image           String?          @db.Text
  price           Decimal          @db.Decimal(10, 2)
  stock           Int              @default(0)
  hasVariants     Boolean          @default(false)
  categoryId      Int
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  orderItems      OrderItem[]
  reviews         Review[]
  sellerName      String           @default("BeautyCare Official Store")
  sellerBadge     String           @default("Official Dermatologist Partner")
  sellerRating    String           @default("4.9 / 5.0")
  sellerCity      String           @default("Jakarta Selatan")
  sellerResponse  String           @default("± 15 Menit")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Review {
  id              Int              @id @default(autoincrement())
  productId       Int
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          Int?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewerName    String
  rating          Int              @default(5)
  comment         String           @db.Text
  userLocation    String?          @default("Jakarta")
  userAvatar      String?          @db.Text
  mediaUrl        String?          @db.Text // Photo or video documentation from buyer
  mediaType       String?          @default("image") // "image" or "video"
  selectedVariant String?          // e.g. "Varian: 50ml"
  helpfulCount    Int              @default(0)
  createdAt       DateTime         @default(now())
}

model CustomerLoyalty {
  id          Int                 @id @default(autoincrement())
  phone       String              @unique
  name        String?
  email       String?
  points      Int                 @default(0)
  tier        String              @default("SILVER") // SILVER, GOLD, PLATINUM
  totalSpent  Decimal             @default(0) @db.Decimal(10, 2)
  history     PointTransaction[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PointTransaction {
  id          Int                 @id @default(autoincrement())
  loyaltyId   Int
  loyalty     CustomerLoyalty     @relation(fields: [loyaltyId], references: [id], onDelete: Cascade)
  points      Int                 // e.g. +100 or -50
  type        String              // "EARN" or "REDEEM"
  description String
  createdAt   DateTime            @default(now())
}

model Article {
  id              Int              @id @default(autoincrement())
  slug            String           @unique
  title           String
  excerpt         String           @db.Text
  content         String           @db.LongText
  coverImage      String           @db.Text
  category        String           // "Tips Skincare", "Panduan Memilih", "Tren Makeup"
  authorName      String           @default("dr. Sarah Melati, Sp.KK")
  authorAvatar    String?          @db.Text
  authorRole      String           @default("Dermatology Specialist")
  readTimeMinutes Int              @default(4)
  publishedAt     DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String      // e.g. "30ml", "50ml", "100ml"
  sizeValue  Int?        // numerical ml value e.g. 30, 50, 100
  price      Decimal     @db.Decimal(10, 2)
  stock      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
}

model Order {
  id              Int         @id @default(autoincrement())
  invoiceNumber   String      @unique
  userId          Int?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String      @db.Text
  paymentMethod   String      // "QRIS", "BANK_TRANSFER", "E_WALLET"
  paymentChannel  String?     // e.g. "QRIS Shopee/Gopay", "BCA", "DANA"
  paymentStatus   String      @default("PENDING") // PENDING, PAID, CANCELLED
  orderStatus     String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, COMPLETED, CANCELLED
  totalAmount     Decimal     @db.Decimal(10, 2)
  pointsEarned    Int         @default(0)
  pointsRedeemed  Int         @default(0)
  discountAmount  Decimal     @default(0) @db.Decimal(10, 2)
  notes           String?     @db.Text
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id           Int             @id @default(autoincrement())
  orderId      Int
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product         @relation(fields: [productId], references: [id])
  variantId    Int?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  selectedSize String?         // e.g. "30ml", "50ml", or null
  quantity     Int             @default(1)
  price        Decimal         @db.Decimal(10, 2)
  subtotal     Decimal         @db.Decimal(10, 2)
}

model PromoEvent {
  id              Int            @id @default(autoincrement())
  title           String
  code            String         @unique
  description     String         @db.Text
  bannerText      String?
  discountPercent Int            @default(20)
  eventMonth      Int?           // e.g. 10, 11, 12
  eventDay        Int?           // e.g. 1, 2, 3
  startDate       DateTime       @default(now())
  endDate         DateTime
  isActive        Boolean        @default(true)
  notifications   Notification[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Notification {
  id          Int         @id @default(autoincrement())
  userId      Int?        // null for broadcast to all customers
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId     Int?
  event       PromoEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  message     String      @db.Text
  type        String      @default("EVENT") // "EVENT", "UPDATE", "ORDER", "SYSTEM"
  link        String?     @default("/#katalog")
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
}
